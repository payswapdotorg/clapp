{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLAPP Package",
  "type": "object",
  "required": ["package", "tests", "provenance"],
  "properties": {
    "package": {
      "type": "object",
      "required": ["id", "version", "category", "purpose", "interface", "supportedTargets"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "category": {"type": "string"},
        "purpose": {"type": "string"},
        "interface": {"type": "object"},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "supportedTargets": {"type": "array", "items": {"type": "string"}},
        "failureModes": {"type": "array", "items": {"type": "object"}},
        "benchmark": {"type": "object"},
        "examples": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["sourceType"],
      "properties": {
        "sourceType": {"type": "string"},
        "sourceProject": {"type": "string"},
        "sourceRevision": {"type": "string"},
        "license": {"type": "string"}
      },
      "additionalProperties": true
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string"},
          "command": {"type": "string"},
          "expected": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
