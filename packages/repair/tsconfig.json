{
  // Standalone typecheck for @clapp/repair (bunx tsc --noEmit -p tsconfig.json).
  // The root program covers packages/*/src/** only (frozen root tsconfig), so
  // this per-package program additionally covers the colocated test battery in
  // test/ and the golden-plan fixture in fixtures/ — the same rigor the sibling
  // packages (@clapp/codegen, @clapp/explore) apply for test/-outside-src
  // layouts.
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "test/**/*.ts", "fixtures/**/*.ts"]
}
