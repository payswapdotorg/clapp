{
  // Standalone typecheck for @clapp/explore (bunx tsc --noEmit -p tsconfig.json).
  // The root program covers packages/*/src/** only (frozen root tsconfig), so
  // this per-package program additionally covers the colocated test battery in
  // test/ — the same rigor the sibling packages get from keeping their tests
  // under src/.
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
